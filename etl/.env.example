# Copiar a .env y editar con las credenciales reales antes de ejecutar.

# URL SQLAlchemy completa (recomendado). Si se define, tiene prioridad sobre
# DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASS.
# DB_URL=mysql+pymysql://sigaps_user:root@localhost:3306/sigaps_db?charset=utf8mb4

DB_HOST=localhost
DB_PORT=3306
DB_NAME=sigaps_db
DB_USER=sigaps_user
DB_PASS=root

# Ruta al Excel origen. Por defecto se busca en ../db/BD_ENF_CAPIIIM_1.xlsx
# (relativo a esta carpeta etl/), o se puede pasar con --file.
EXCEL_PATH=../db/BD_ENF_CAPIIIM_1.xlsx

# Filas por lote antes de hacer commit.
BATCH_SIZE=500
